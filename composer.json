{
    "name": "masterix21/laravel-contacts",
    "description": "Add contacts book abilities to any Laravel project",
    "keywords": [
        "LucaLongo",
        "laravel",
        "laravel-contacts"
    ],
    "homepage": "https://github.com/masterix21/laravel-contacts",
    "license": "MIT",
    "authors": [
        {
            "name": "Luca Longo",
            "email": "l.longo@ambita.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/contracts": "^10.0||^11.0||^12.0",
        "solution-forest/filament-tree": "^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.10||^8.1",
        "larastan/larastan": "^2.9",
        "orchestra/testbench": "^9.0||^8.22",
        "pestphp/pest": "^2.34||^3.0",
        "pestphp/pest-plugin-arch": "^2.7",
        "pestphp/pest-plugin-laravel": "^2.3",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-phpunit": "^1.3",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "LucaLongo\\LaravelContacts\\": "src/",
            "LucaLongo\\LaravelContacts\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LucaLongo\\LaravelContacts\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-contacts --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LucaLongo\\LaravelContacts\\LaravelContactsServiceProvider"
            ],
            "aliases": {
                "LaravelContacts": "LucaLongo\\LaravelContacts\\Facades\\LaravelContacts"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
